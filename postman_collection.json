              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings", "room", ":roomId"],
              "variable": [
                {
                  "key": "roomId",
                  "value": ""
                }
              ]
            }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
